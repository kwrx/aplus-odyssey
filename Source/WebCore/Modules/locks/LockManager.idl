[
    ActiveDOMObject,
    Exposed=Window,
    SecureContext,
] interface LockManager {
    [JSBuiltin] Promise<any> request(DOMString name, any options, optional any callback);
    [JSBuiltin] Promise<any> query();

    [PrivateIdentifier] unsigned long long newLockRequestId();
    [PrivateIdentifier] Promise<boolean> requestLock(unsigned long long id, DOMString name, boolean exclusive, boolean ifAvailable, boolean steal);
    [PrivateIdentifier] undefined releaseLock(unsigned long long id);
    [PrivateIdentifier] sequence<DOMString> lockSnapshot();
};
